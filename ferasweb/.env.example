# Privy — same application as the mobile app. The mobile client ID is scoped to
# native identifiers and blocks browser origins, so it stays unset for web until
# http://localhost:5173 (and the production domain) are added to that client's
# allowed origins in the Privy dashboard.
VITE_PRIVY_APP_ID=cmvtpoxdq00ls0hl3kv9amzj5
# VITE_PRIVY_CLIENT_ID=client-WY6etoes1M5Kft6sJmYC2vgqN494RSFn8uViTTmQ3wh4n

# Feras Devnet market API (match, replay and position endpoints).
# Deployed backend behind CloudFront. For local API work, override with
# VITE_FERAS_MARKET_API_URL=http://127.0.0.1:8787
VITE_FERAS_MARKET_API_URL=https://dqrwnhn2nif0u.cloudfront.net

# Solana Devnet market configuration.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_FERAS_MARKET_PROGRAM_ID=3UJi7D53Cbj5TLGbbxFCzqW9vE7Ji5N5KKEdbQMWFaFA
VITE_DEVNET_USDC_MINT=CwhBMtAs7tAHSabWrW2Dg2hgQ7Ktt7pW86UR35Be9VrU

