{
  "expo": {
    "name": "Feras",
    "slug": "feras",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "feras",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feras.app"
    },
    "android": {
      "package": "com.feras.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "react-native-quick-crypto"
    ]
  }
}
