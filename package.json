{
  "name": "feras",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:dev": "expo run:android --device",
    "start:dev-client": "expo start --dev-client --tunnel",
    "start:market-api": "node market-api/server.js",
    "start:coordinator": "node backend/src/worker.js",
    "start:admin": "node admin/server.js",
    "migrate:backend": "node backend/src/migrate.js",
    "create:match": "node backend/src/create-match.js",
    "confirm:market": "node backend/src/confirm-market.js",
    "test:backend": "node --test tests/backend-*.test.js",
    "test:program": "NO_DNA=1 RUSTUP_TOOLCHAIN=nightly-2024-04-18 anchor test",
    "test:program:fast": "NO_DNA=1 RUSTUP_TOOLCHAIN=nightly-2024-04-18 anchor test --skip-build",
    "test:program:client": "mocha --timeout 120000 tests/feras-market.js",
    "test:release-config": "node --test tests/devnet-release-config.test.js",
    "validate:devnet-config": "node scripts/validate-devnet-release-config.js",
    "verify:devnet-deployment": "node scripts/verify-devnet-deployment.js",
    "verify:program:repro": "bash scripts/verify-reproducible-sbf.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@solana/kit": "^8.4.0",
    "@solana/kit-plugin-instruction-plan": "^0.19.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@tanstack/react-query": "^5.62.8",
    "@wallet-ui/react-native-kit": "^4.4.1",
    "chess.js": "1.4.0",
    "expo": "^57.0.27",
    "expo-asset": "^57.0.18",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "query-string": "^9.5.1",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-chessboard": "0.2.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.8",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@coral-xyz/anchor": "^0.30.1",
    "@expo/ngrok": "^4.1.3",
    "@solana/spl-token": "^0.4.14",
    "@types/react": "~19.2.4",
    "mocha": "^11.7.4",
    "typescript": "~6.0.3"
